<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarafa Community Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    {{!-- Logo Links --}}
    <link rel="icon" href="/assets/favicon/favicon_logo.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/favicon/favicon_logo.png">
    <style>
        /* =========================================================
       NORMAL / DESKTOP
       ========================================================= */

        .payment-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            font-size: 15px;
            box-shadow: 0 2px 8px rgba(47, 149, 255, 0.07);
        }

        .payment-table th,
        .payment-table td {
            padding: 12px 8px;
            text-align: left;
            border-bottom: 1px solid #f1f5f9;
        }

        .payment-table th {
            background: #f8fafc;
            font-weight: 600;
            color: #374151;
        }

        .payment-table tr:last-child td {
            border-bottom: none;
        }

        /* Status */
        .status-badge {
            background: #d1f7e6;
            color: #1b8c4a;
            padding: 4px 12px;
            border-radius: 14px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-badge.pending {
            background: #fef3c7;
            color: #b45309;
        }

        /* Page Title */
        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .page-title i {
            color: #2f95ff;
        }

        /* View Link */
        .view-link {
            color: #2f95ff;
            text-decoration: none;
            font-weight: 500;
        }

        .view-link:hover {
            text-decoration: underline;
        }

        /* =========================================================
       FILTERS - NORMAL
       ========================================================= */

        .payment-filters {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .payment-filters input,
        .payment-filters select {
            padding: 10px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            min-width: 180px;
            outline: none;
        }

        .payment-filters input:focus,
        .payment-filters select:focus {
            border-color: #2f95ff;
        }

        /* =========================================================
       SCREENSHOT MODAL - NORMAL
       ========================================================= */

        .ss-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .6);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }

        .ss-modal-overlay.active {
            display: flex;
        }

        .ss-modal-box {
            position: relative;
            max-width: 90vw;
            max-height: 90vh;
            background: #fff;
            border-radius: 12px;
            padding: 16px;
        }

        .ss-modal-box img {
            max-width: 100%;
            max-height: 80vh;
            display: block;
            border-radius: 8px;
            margin: 0 auto;
        }

        .ss-modal-close {
            position: absolute;
            top: -14px;
            right: -14px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #111827;
            color: #fff;
            border: none;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        /* =========================================================
       TABLET - 769px to 1024px
       ========================================================= */

        @media (min-width: 769px) and (max-width: 1024px) {

            .main-content {
                padding: 20px !important;
            }

            .page-title {
                font-size: 22px;
                margin-bottom: 20px;
            }

            /* Payment Container */

            .payment-records-list {
                background: #fff;
                border-radius: 14px;
                padding: 16px;
                box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
                margin-bottom: 80px !important;
            }

            /* Filters */

            .payment-filters {
                display: grid;
                grid-template-columns: 1.4fr 1fr 1fr;
                gap: 12px;
                margin-bottom: 22px;
                width: 100%;
            }

            .payment-filters input,
            .payment-filters select,
            .payment-filters button {
                width: 100%;
                min-width: 0;
                min-height: 44px;
                box-sizing: border-box;
            }

            /* First Row
           Search | Date | Method
        */

            #groupFilter {
                grid-column: 1;
            }

            #dateFilter {
                grid-column: 2;
            }

            #methodFilter {
                grid-column: 3;
            }

            /* Second Row
           Status | Clear
        */

            #statusFilter {
                grid-column: 1;
            }

            #clearFilters {
                grid-column: 2;
            }

            /* Table */

            .payment-table {
                box-shadow: none;
            }
        }


        /* =========================================================
       MOBILE - 768px and below
       ========================================================= */

        @media (max-width: 768px) {

            .main-content {
                padding-bottom: 100px !important;
            }

            .page-title {
                font-size: 20px;
                margin-bottom: 18px;
            }

            /* Payment Container */

            .payment-records-list {
                padding: 12px !important;
                padding-bottom: 30px !important;
                margin-bottom: 80px !important;
                background: #fff;
                border-radius: 14px;
                box-shadow: 0 4px 16px rgba(0, 0, 0, .06);
            }

            /* Filters */

            .payment-filters {
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin-bottom: 22px;
            }

            .payment-filters input,
            .payment-filters select,
            .payment-filters button {
                width: 100%;
                min-width: 0;
                min-height: 44px;
                box-sizing: border-box;
            }

            /* =====================================================
           PAYMENT TABLE → CARD
           ===================================================== */

            .payment-table,
            .payment-table tbody,
            .payment-table tr,
            .payment-table td {
                display: block;
                width: 100%;
                box-sizing: border-box;
            }

            .payment-table {
                background: transparent;
                box-shadow: none;
                border: none;
            }

            .payment-table thead {
                display: none;
            }

            /* Payment Card */

            .payment-table tbody tr {
                background: #fff;
                border: 1px solid #e5e7eb;
                border-radius: 14px;
                padding: 14px;
                margin-bottom: 16px;
                box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
            }

            /* Card Fields */

            .payment-table tbody tr td {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 15px;

                padding: 10px 2px;
                border-bottom: 1px solid #f1f5f9;

                font-size: 14px;
                line-height: 1.5;
                text-align: right;

                color: #111827;
                font-weight: 500;
            }

            .payment-table tbody tr td:last-child {
                border-bottom: none;
            }

            /* Field Labels */

            .payment-table tbody tr td::before {
                content: attr(data-label);
                display: block;

                flex: 0 0 85px;

                font-size: 13px;
                font-weight: 600;
                color: #6b7280;

                text-align: left;
            }

            /* Amount */

            .payment-table tbody tr td:nth-child(5) {
                font-weight: 700;
            }

            /* Status */

            .payment-table tbody tr td:nth-child(6) {
                align-items: center;
            }

            .payment-table tbody tr td:nth-child(6)::before {
                align-self: flex-start;
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;

                padding: 5px 10px;
                border-radius: 20px;

                font-size: 11px;
                white-space: nowrap;
            }

            /* Reupload Link */

            .reupload-link {
                display: inline-block;
                margin-top: 6px;
                font-size: 12px;
                text-align: right;
            }

            /* Screenshot Button */

            .payment-table .view-screenshot-btn {
                padding: 7px 12px;
                font-size: 12px;
                white-space: nowrap;
            }

            /* Empty State */

            .payment-table tbody tr td[colspan] {
                display: block;
                text-align: center;
                padding: 25px 10px;
            }

            .payment-table tbody tr td[colspan]::before {
                display: none;
            }
        }
    </style>
</head>

<body data-user-id="{{user._id}}">
    {{> header}}

    <div class="main-container">
        {{> sidebar}}
        <main class="main-content">
            <h2 class="page-title"><i class="fas fa-receipt"></i> My Payments</h2>

            <div class="payment-records-list" style="margin-bottom:32px;">
                <div style="overflow-x:auto;">
                    <div class="payment-filters">
                        <input type="text" id="groupFilter" placeholder="Search Group">

                        <input type="date" id="dateFilter">

                        <select id="methodFilter">
                            <option value="">All Methods</option>
                            <option value="Cash">Cash</option>
                            <option value="UPI">UPI</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>

                        <select id="statusFilter">
                            <option value="">All Status</option>
                            <option value="Verified">Verified</option>
                            <option value="Pending">Pending</option>
                            <option value="Reupload Required">Reupload Required</option>
                        </select>

                        <button id="clearFilters" class="action-btn">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    </div>
                    <table class="payment-table">
                        <thead>
                            <tr>
                                <th>Group</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Screenshot</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each payments}}
                            <tr>
                                <td data-label="Group">{{this.group.g_name}}</td>
                                <td data-label="Date">{{this.date}}</td>
                                <td data-label="Time">{{this.time}}</td>
                                <td data-label="Method">{{this.method}}</td>
                                <td data-label="Amount">₹{{this.amount}}</td>
                                <td data-label="Status">
                                    {{#if this.reuploadRequested}}
                                    <span class="status-badge reupload">Reupload Required</span>
                                    <br>
                                    <a href="/pay/SS-upload?groupId={{this.group._id}}&paymentId={{this._id}}"
                                        class="reupload-link">
                                        <i class="fas fa-upload"></i> Upload New Screenshot
                                    </a>
                                    {{else if this.isVerified}}
                                    <span class="status-badge">Verified</span>
                                    {{else}}
                                    <span class="status-badge pending">Pending</span>
                                    {{/if}}
                                </td>
                                <td data-label="Screenshot">
                                    {{#if this.screenshot_url}}
                                    <button type="button" class="action-btn view-screenshot-btn"
                                        data-src="{{this.screenshot_url}}" title="View">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                    {{else}}
                                    <span style="color:#9ca3af; font-size:13px;">—</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="7">No payment records found.</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <div id="screenshotModal" class="ss-modal-overlay">
        <div class="ss-modal-box">
            <button type="button" class="ss-modal-close" id="closeScreenshotModal">
                <i class="fas fa-times"></i>
            </button>
            <img id="screenshotModalImg" src="" alt="Payment Screenshot">
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $(document).on('click', '.view-screenshot-btn', function () {
                const src = $(this).data('src');
                $('#screenshotModalImg').attr('src', src);
                $('#screenshotModal').addClass('active');
            });
            $('#closeScreenshotModal').on('click', () => $('#screenshotModal').removeClass('active'));
            $('#screenshotModal').on('click', function (e) { if (e.target === this) $(this).removeClass('active'); });
        })
    </script>
    {{!-- Filters --}}
    <script>
        function filterPayments() {

            const group = $("#groupFilter").val().toLowerCase();
            const date = $("#dateFilter").val();
            const method = $("#methodFilter").val().toLowerCase();
            const status = $("#statusFilter").val().toLowerCase();

            $(".payment-table tbody tr").each(function () {

                if ($(this).find("td").length === 1) return;

                const row = $(this);

                const rowGroup = row.find("td:eq(0)").text().toLowerCase().trim();
                const rowDate = row.find("td:eq(1)").text().trim();
                const rowMethod = row.find("td:eq(3)").text().toLowerCase().trim();
                const rowStatus = row.find("td:eq(5)").text().toLowerCase().trim();

                const matchGroup = rowGroup.includes(group);
                const matchDate = !date || rowDate.includes(date);
                const matchMethod = !method || rowMethod === method;
                const matchStatus = !status || rowStatus.includes(status);

                row.toggle(matchGroup && matchDate && matchMethod && matchStatus);

            });
        }

        $("#groupFilter,#dateFilter,#methodFilter,#statusFilter")
            .on("keyup change", filterPayments);

        $("#clearFilters").click(function () {

            $("#groupFilter").val("");
            $("#dateFilter").val("");
            $("#methodFilter").val("");
            $("#statusFilter").val("");

            filterPayments();

        });
    </script>

    <script src="/js/all.js"></script>
</body>