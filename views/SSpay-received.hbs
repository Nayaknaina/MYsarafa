    <script>
        let periodState = {
            amountType: 'monthly',
            createdAt: null,
            paidPeriods: [],
            viewYear: new Date().getFullYear(),
            selected: null
        };

        $('#openCashModal').click(() => {
            $('#cashEntryModal').css('display', 'flex');
        });

        $('#cancelCashEntry').click(() => {
            $('#cashEntryModal').hide();
            resetCashForm();
        });

        function resetCashForm() {
            $('#cashGroupSelect').val('');
            $('#cashMemberSelect').html('<option value="">Select Member</option>');
            $('#cashAmount').val('');
            $('#cashDate').val('');
            resetPeriodPicker();
        }

        function resetPeriodPicker() {
            periodState = { amountType: 'monthly', createdAt: null, paidPeriods: [], viewYear: new Date().getFullYear(), selected: null };
            $('#period').val('');
            $('#periodDisplayText').text('Select Member First');
            $('#periodDisplay').addClass('disabled');
            closePeriodCalendar();
        }

        // Group change -> members list load karo
        $('#cashGroupSelect').on('change', async function () {
            const groupId = $(this).val();
            $('#cashMemberSelect').html('<option value="">Select Member</option>');
            resetPeriodPicker();
            if (!groupId) return;

            try {
                const res = await fetch(`/pay/group-members-list/${groupId}`, {
                    method: 'GET',
                    credentials: 'include',
                    headers: {
                        'Authorization': `Bearer ${document.cookie.split('token=')[1]?.split(';')[0] || ''}`
                    }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    if (data.members.length === 0) {
                        $('#cashMemberSelect').append('<option value="" disabled>No members found</option>');
                    }
                    data.members.forEach(m => {
                        $('#cashMemberSelect').append(`<option value="${m.id}">${m.name}</option>`);
                    });
                } else {
                    toastr.error(data.message || 'Failed to load members');
                }
            } catch (err) {
                toastr.error('Error loading members: ' + err.message);
            }
        });

        // Member change -> uske paid periods load karo (memberId query param se admin apne group ke kisi bhi member ka status dekh sakta hai)
        $('#cashMemberSelect').on('change', async function () {
            const memberId = $(this).val();
            const groupId = $('#cashGroupSelect').val();
            resetPeriodPicker();
            if (!memberId || !groupId) return;

            try {
                const res = await fetch(`/pay/user-period-status/${groupId}?memberId=${memberId}`, {
                    method: 'GET',
                    credentials: 'include',
                    headers: {
                        'Authorization': `Bearer ${document.cookie.split('token=')[1]?.split(';')[0] || ''}`
                    }
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    periodState.amountType = data.amountType;
                    periodState.createdAt = data.createdAt;
                    periodState.paidPeriods = data.paidPeriods;
                    periodState.viewYear = data.createdAt ? new Date(data.createdAt).getFullYear() : new Date().getFullYear();
                    $('#periodDisplay').removeClass('disabled');
                    $('#periodDisplayText').text('Select Period');
                } else {
                    toastr.error(data.message || 'Failed to load payment status');
                }
            } catch (err) {
                toastr.error('Error: ' + err.message);
            }
        });

        // Calendar open/close
        $('#periodDisplay').on('click', function (e) {
            e.stopPropagation();
            if ($(this).hasClass('disabled')) return;
            if ($('#periodCalendar').hasClass('active')) {
                closePeriodCalendar();
            } else {
                renderPeriodCalendar();
                $('#periodCalendar').addClass('active');
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#periodCalendar, #periodDisplay').length) {
                closePeriodCalendar();
            }
        });

        function closePeriodCalendar() {
            $('#periodCalendar').removeClass('active');
        }

        function renderPeriodCalendar() {
            const createdDate = periodState.createdAt ? new Date(periodState.createdAt) : null;
            const minYear = createdDate ? createdDate.getFullYear() : new Date().getFullYear();
            const minMonth = createdDate ? createdDate.getMonth() : 0;

            if (periodState.amountType === 'monthly') {
                $('.period-calendar-header').show();
                $('#periodMonthsGrid').show();
                $('#periodYearsGrid').hide();

                if (periodState.viewYear < minYear) periodState.viewYear = minYear;
                $('#periodCalendarYear').text(periodState.viewYear);
                $('#periodPrevYear').prop('disabled', periodState.viewYear <= minYear);

                const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                let html = '';
                months.forEach((m, idx) => {
                    const value = `${periodState.viewYear}-${String(idx + 1).padStart(2, '0')}`;
                    const isBefore = periodState.viewYear === minYear && idx < minMonth;
                    const isPaid = periodState.paidPeriods.includes(value);
                    let cls = 'period-cell';
                    if (isBefore) cls += ' disabled-before';
                    else if (isPaid) cls += ' paid';
                    if (periodState.selected === value) cls += ' selected';
                    html += `<div class="${cls}" data-value="${value}" data-label="${m} ${periodState.viewYear}" data-paid="${isPaid}" data-before="${isBefore}">${m.slice(0, 3)}</div>`;
                });
                $('#periodMonthsGrid').html(html);
            } else if (periodState.amountType === 'yearly') {
                $('.period-calendar-header').hide();
                $('#periodMonthsGrid').hide();
                $('#periodYearsGrid').show();

                let html = '';
                for (let y = minYear; y <= minYear + 10; y++) {
                    const value = `${y}`;
                    const isPaid = periodState.paidPeriods.includes(value);
                    let cls = 'period-cell';
                    if (isPaid) cls += ' paid';
                    if (periodState.selected === value) cls += ' selected';
                    html += `<div class="${cls}" data-value="${value}" data-label="${y}" data-paid="${isPaid}" data-before="false">${y}</div>`;
                }
                $('#periodYearsGrid').html(html);
            } else {
                $('.period-calendar-header').hide();
                $('#periodYearsGrid').hide();
                $('#periodMonthsGrid').show().html('<div style="grid-column:1/-1; color:#9ca3af; text-align:center;">Period not available</div>');
            }
        }

        $('#periodPrevYear').on('click', function () {
            periodState.viewYear--;
            renderPeriodCalendar();
        });
        $('#periodNextYear').on('click', function () {
            periodState.viewYear++;
            renderPeriodCalendar();
        });

        $(document).on('click', '.period-cell', function () {
            if ($(this).data('before') === true || $(this).data('before') === 'true') {
                toastr.warning('Group banne se pehle ka period select nahi kar sakte');
                return;
            }
            if ($(this).data('paid') === true || $(this).data('paid') === 'true') {
                toastr.info(`Payment already done for this ${periodState.amountType === 'monthly' ? 'month' : 'year'}`);
                return;
            }
            const value = $(this).data('value');
            const label = $(this).data('label');
            periodState.selected = value;
            $('#period').val(value);
            $('#periodDisplayText').text(label);
            renderPeriodCalendar();
            closePeriodCalendar();
        });

        // Submit
        $('#submitCashEntry').click(async function () {
            const groupId = $('#cashGroupSelect').val();
            const memberId = $('#cashMemberSelect').val();
            const amount = $('#cashAmount').val();
            const date = $('#cashDate').val();
            const period = $('#period').val();

            if (!groupId || !memberId || !amount || !period) {
                toastr.error('Please fill all required fields, including period');
                return;
            }

            try {
                const res = await fetch('/pay/manual-entry', {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${document.cookie.split('token=')[1]?.split(';')[0] || ''}`
                    },
                    body: JSON.stringify({ groupId, memberId, amount, date, period })
                });
                const result = await res.json();
                if (res.ok && result.success) {
                    toastr.success('Cash payment recorded');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    toastr.error(result.message || 'Failed to record payment');
                }
            } catch (err) {
                toastr.error('Error: ' + err.message);
            }
        });
    </script>
