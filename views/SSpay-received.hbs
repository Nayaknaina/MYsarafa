<style>
    .payment-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        font-size: 15px;
        box-shadow: 0 2px 8px rgba(47, 149, 255, 0.07);
    }

    .filters-section {
        background: white;
        border-radius: 16px;
        padding: 7px;
        margin-bottom: 4px;
        box-shadow: 0 4px 20px rgba(47, 149, 255, 0.1);
        border: 1px solid #e5e7eb;
    }

    .filters-title {
        font-size: 20px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filters-title i {
        color: #2f95ff;
    }

    .filters-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .filter-label {
        font-size: 14px;
        font-weight: 500;
        color: #374151;
        margin-bottom: 8px;
    }

    .filter-input {
        padding: 12px 16px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        background: white;
        transition: border-color 0.2s;
    }

    .search-btn {
        padding: 12px 16px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 14px;
        background: #2f95ff;
        color: #fff;
        cursor: pointer;
        transition: background 0.2s;
    }

    .filter-input:focus {
        outline: none;
        border-color: #2f95ff;
        box-shadow: 0 0 0 3px rgba(47, 149, 255, 0.1);
    }

    .payment-table th,
    .payment-table td {
        padding: 12px 8px;
        text-align: left;
        border-bottom: 1px solid #f1f5f9;
    }

    .payment-table th {
        background: #f8fafc;
        font-weight: 600;
        color: #374151;
    }

    .payment-table tr:last-child td {
        border-bottom: none;
    }

    .status-badge {
        background: #d1f7e6;
        color: #1b8c4a;
        padding: 4px 12px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-badge.pending {
        background: #fef3c7;
        color: #b45309;
    }

    .screenshot-btn {
        background: none;
        border: none;
        color: #2f95ff;
        font-size: 18px;
        cursor: pointer;
        transition: color 0.2s;
    }

    .screenshot-btn:hover {
        color: #551DFF;
    }

    .action-btn {
        background: #fff;
        border: 1px solid #d1d5db;
        color: #374151;
        border-radius: 8px;
        font-size: 14px;
        padding: 6px 10px;
        margin-right: 2px;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
    }

    .action-btn.primary {
        background: #2f95ff;
        color: #fff;
        border-color: #2f95ff;
    }

    .action-btn:hover {
        background: #f3f4f6;
        border-color: #9ca3af;
    }

    .action-btn.primary:hover {
        background: #1d7dd8;
    }

    @media (max-width: 700px) {

        .payment-table th,
        .payment-table td {
            padding: 8px 4px;
            font-size: 13px;
        }

        .payment-table {
            font-size: 13px;
        }
    }

    @media (max-width: 500px) {

        .payment-table,
        .payment-table thead,
        .payment-table tbody,
        .payment-table th,
        .payment-table td,
        .payment-table tr {
            display: block;
        }

        .payment-table thead {
            display: none;
        }

        .payment-table tr {
            margin-bottom: 16px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 1px 3px rgba(47, 149, 255, 0.07);
            padding: 8px;
        }

        .payment-table td {
            padding: 8px 6px;
            border-bottom: none;
            position: relative;
        }

        .payment-table td:before {
            content: attr(data-label);
            font-weight: 600;
            color: #374151;
            display: block;
            margin-bottom: 2px;
            font-size: 12px;
        }
    }

    .action-dropdown {
        position: relative;
        display: inline-block;
    }

    .action-main-btn {
        background: #fff;
        border: 1px solid #d1d5db;
        color: #374151;
        border-radius: 8px;
        font-size: 18px;
        padding: 6px 12px;
        cursor: pointer;
        transition: background 0.2s, border-color 0.2s;
    }

    .action-main-btn:hover {
        background: #f3f4f6;
        border-color: #9ca3af;
    }

    .action-dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 110%;
        min-width: 120px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(47, 149, 255, 0.10);
        z-index: 10;
        flex-direction: column;
        padding: 6px 0;
    }

    .action-dropdown:hover .action-dropdown-menu,
    .action-main-btn:focus+.action-dropdown-menu {
        display: flex;
    }

    .action-dropdown-menu .action-btn {
        width: 100%;
        border: none;
        background: none;
        color: #374151;
        border-radius: 0;
        font-size: 15px;
        padding: 8px 16px;
        text-align: left;
        cursor: pointer;
        transition: background 0.2s;
        margin: 0;
    }

    .action-dropdown-menu .action-btn.primary {
        color: #2f95ff;
    }

    .action-dropdown-menu .action-btn:hover {
        background: #f3f4f6;
    }

    .action-dropdown-menu .action-btn.primary:hover {
        background: #e7f3ff;
    }

    @media (max-width: 500px) {
        .action-dropdown-menu {
            min-width: 100px;
            right: 0;
            left: auto;
        }
    }

    .payment-records-list>div {
        overflow-x: auto;
        overflow-y: visible;
    }

    .payment-table {
        overflow: visible;
    }

    /* Filter action buttons ko baaki filter-inputs ke sath align karna */
    .filters-row .filter-group:has(.search-btn),
    .filters-row .filter-group:has(.upload-btn) {
        justify-content: flex-end;
    }

    .search-btn,
    .filter-group .upload-btn {
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        white-space: nowrap;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
    }

    .search-btn {
        background: #2f95ff;
        border: none;
        color: #fff;
        transition: background 0.2s;
    }

    .search-btn:hover {
        background: #1d7dd8;
    }

    .filter-group .upload-btn {
        background: linear-gradient(245deg, #D324A8 -67.04%, #551DFF 129.05%);
        border: none;
        color: #fff;
        cursor: pointer;
        transition: filter 0.2s, transform 0.1s;
    }

    .filter-group .upload-btn:hover {
        filter: brightness(1.08);
    }

    .filter-group .upload-btn:active {
        transform: scale(0.97);
    }

    .filter-group .upload-btn i {
        font-size: 14px;
    }

    .ss-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .6);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

    .ss-modal-overlay.active {
        display: flex;
    }

    .ss-modal-box {
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
        background: #fff;
        border-radius: 12px;
        padding: 16px;
    }

    .ss-modal-box img {
        max-width: 100%;
        max-height: 80vh;
        display: block;
        border-radius: 8px;
        margin: 0 auto;
    }

    .ss-modal-close {
        position: absolute;
        top: -14px;
        right: -14px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #111827;
        color: #fff;
        border: none;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .period-display {
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .period-display i {
        color: #2f95ff;
    }

    .period-display.disabled {
        opacity: .6;
        cursor: not-allowed;
        background: #f8fafc;
    }

    .period-calendar {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: 6px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(47, 149, 255, 0.15);
        padding: 12px;
        z-index: 200;
    }

    .period-calendar.active {
        display: block;
    }

    .period-calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        font-weight: 600;
        color: #111827;
        font-size: 14px;
    }

    .period-nav-btn {
        background: #f3f4f6;
        border: none;
        border-radius: 6px;
        width: 28px;
        height: 28px;
        cursor: pointer;
        color: #374151;
    }

    .period-nav-btn:hover {
        background: #e5e7eb;
    }

    .period-nav-btn:disabled {
        opacity: .4;
        cursor: not-allowed;
    }

    .period-calendar-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .period-cell {
        padding: 10px 4px;
        text-align: center;
        border-radius: 8px;
        font-size: 13px;
        cursor: pointer;
        border: 1px solid transparent;
        transition: background .2s, border-color .2s;
        color: #374151;
    }

    .period-cell:hover {
        background: #e7f3ff;
        border-color: #2f95ff;
    }

    .period-cell.selected {
        background: #2f95ff;
        color: #fff;
        font-weight: 600;
    }

    .period-cell.disabled-before {
        color: #d1d5db;
        cursor: not-allowed;
        text-decoration: line-through;
    }

    .period-cell.paid {
        background: #fef3c7;
        color: #b45309;
        cursor: not-allowed;
        text-decoration: line-through;
    }
</style>

<body data-user-id="{{user._id}}">
    {{> header}}

    <div class="main-container">
        {{> sidebar}}
        <main class="main-content">
            <div class="filters-section">
                <h3 class="filters-title">
                    <i class="fas fa-filter"></i>
                    Filter Payments
                </h3>
                <div class="filters-row">
                    <div class="filter-group">
                        <label class="filter-label">Search Member</label>
                        <input type="text" class="filter-input" id="searchMember" placeholder="Enter name or ID">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">Payment Method</label>
                        <select class="filter-input" id="filterMethod">
                            <option value="">All Methods</option>
                            <option value="UPI">UPI</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cash">Cash</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">Date Range</label>
                        <input type="date" class="filter-input" id="filterDate">
                    </div>
                    <div class="filter-group">
                        <button class="search-btn" id="applyFilters">Apply Filters</button>
                    </div>
                    <div class="filter-group">
                        <button class="upload-btn" id="openCashModal" type="button">
                            <i class="fas fa-money-bill-wave"></i> Add Cash Payment
                        </button>
                    </div>
                </div>
            </div>
            <div class="payment-records-list" style="margin-bottom:32px;">
                <div style="overflow-x:auto;">
                    <table class="payment-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Group</th>
                                <th>UPI ID</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="paymentTableBody">
                            {{#each payments}}
                            <tr>
                                <td data-label="Name">{{this.user.f_name}} {{this.user.l_name}}</td>
                                <td data-label="Group">{{this.group.g_name}}</td>
                                <td data-label="UPI ID">{{this.upiId}}</td>
                                <td data-label="Date">{{this.date}}</td>
                                <td data-label="Time">{{this.time}}</td>
                                <td data-label="Method">{{this.method}}</td>
                                <td data-label="Amount">₹{{this.amount}}</td>
                                <td data-label="Status">
                                    <span class="status-badge {{#if this.isVerified}}green{{else}}pending{{/if}}">
                                        {{#if this.isVerified}}Verified{{else}}Pending{{/if}}
                                    </span>
                                </td>
                                <td data-label="Actions">
                                    <div class="action-dropdown">
                                        <button class="action-main-btn" title="Actions">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                        <div class="action-dropdown-menu">
                                            {{#if (eq this.method "Cash")}}
                                            <span
                                                style="color:#9ca3af; font-size:13px; padding: 8px 16px; display:block;">No
                                                screenshot</span>
                                            <button class="action-btn primary" title="Verified" disabled>
                                                <i class="fas fa-check"></i> Verified
                                            </button>
                                            {{else}}
                                            <button type="button" class="action-btn view-screenshot-btn"
                                                data-src="{{this.screenshot_url}}" title="View">
                                                <i class="fas fa-eye"></i> View
                                            </button>
                                            <a href="{{this.screenshot_url}}" download class="action-btn"
                                                title="Download">
                                                <i class="fas fa-download"></i> Download
                                            </a>

                                            {{#if this.isVerified}}
                                            <button class="action-btn primary verify-btn" data-payment-id="{{this._id}}"
                                                title="Verify" disabled>
                                                <i class="fas fa-check"></i> Verify
                                            </button>
                                            <button class="action-btn reupload-btn" data-payment-id="{{this._id}}"
                                                title="Reupload">
                                                <i class="fas fa-undo"></i> Reupload
                                            </button>
                                            {{else}}
                                            <button class="action-btn primary verify-btn" data-payment-id="{{this._id}}"
                                                title="Verify">
                                                <i class="fas fa-check"></i> Verify
                                            </button>
                                            <button class="action-btn reupload-btn" data-payment-id="{{this._id}}"
                                                title="Reupload" disabled>
                                                <i class="fas fa-undo"></i> Reupload
                                            </button>
                                            {{/if}}
                                            {{/if}}
                                        </div>
                                    </div>
                                </td>

                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="9">No payment records found.</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    {{!-- Cash Payment --}}
    <!-- Modal -->
    <div id="cashEntryModal"
        style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:50; align-items:center; justify-content:center;">
        <div style="background:#fff; border-radius:12px; padding:24px; width:360px; max-width:90%;">
            <h3 style="margin-bottom:16px;">Add Cash Payment</h3>
            <select id="cashGroupSelect" class="filter-input" style="margin-bottom:10px; width:100%;">
                <option value="">Select Group</option>
                {{#each groups}}
                <option value="{{this._id}}">{{this.g_name}}</option>
                {{/each}}
            </select>
            <select id="cashMemberSelect" class="filter-input" style="margin-bottom:10px; width:100%;">
                <option value="">Select Member</option>
            </select>
            <input type="number" id="cashAmount" class="filter-input" placeholder="Amount"
                style="margin-bottom:10px; width:100%;">
            <input type="date" id="cashDate" class="filter-input" style="margin-bottom:16px; width:100%;">
            {{!-- <select id="period" required>
                <option value="">Select Period</option>
            </select> --}}
            <div style="position:relative; margin-bottom:16px;">
                <div id="periodDisplay" class="filter-input period-display disabled" tabindex="0">
                    <span id="periodDisplayText">Select Member First</span>
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <input type="hidden" id="period" required>

                <div id="periodCalendar" class="period-calendar">
                    <div class="period-calendar-header">
                        <button type="button" class="period-nav-btn" id="periodPrevYear">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span id="periodCalendarYear">2026</span>
                        <button type="button" class="period-nav-btn" id="periodNextYear">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="period-calendar-grid" id="periodMonthsGrid"></div>
                    <div class="period-calendar-grid" id="periodYearsGrid" style="display:none;"></div>
                </div>
            </div>
            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <button id="cancelCashEntry" class="action-btn">Cancel</button>
                <button id="submitCashEntry" class="action-btn primary">Save</button>
            </div>
        </div>
    </div>

    <div id="screenshotModal" class="ss-modal-overlay">
        <div class="ss-modal-box">
            <button type="button" class="ss-modal-close" id="closeScreenshotModal">
                <i class="fas fa-times"></i>
            </button>
            <img id="screenshotModalImg" src="" alt="Payment Screenshot">
        </div>
    </div>

    <script>
        $(document).ready(function () {
            function showNotification(message, type) {
                toastr[type](message);
            }

            // Handle Verify button
            $(document).on('click', '.verify-btn', async function () {
                const paymentId = $(this).data('payment-id');
                try {
                    const response = await fetch(`/pay/verify/${paymentId}`, {
                        method: 'POST',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${document.cookie.split('token=')[1]?.split(';')[0]}`
                        }
                    });
                    const result = await response.json();
                    if (response.ok && result.success) {
                        showNotification('Payment verified successfully', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(result.message || 'Failed to verify payment', 'error');
                    }
                } catch (error) {
                    showNotification('Error verifying payment: ' + error.message, 'error');
                }
            });

            // Handle Reupload button
            $(document).on('click', '.reupload-btn', async function () {
                const paymentId = $(this).data('payment-id');
                try {
                    const response = await fetch(`/pay/unverify/${paymentId}`, {
                        method: 'POST',
                        credentials: 'include',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${document.cookie.split('token=')[1]?.split(';')[0]}`
                        }
                    });
                    const result = await response.json();
                    if (response.ok && result.success) {
                        showNotification('Payment marked for reupload', 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(result.message || 'Failed to mark payment for reupload', 'error');
                    }
                } catch (error) {
                    showNotification('Error marking payment for reupload: ' + error.message, 'error');
                }
            });

            // Handle filters (client-side for simplicity)
            $('#applyFilters').click(function () {
                const searchMember = $('#searchMember').val().trim().toLowerCase();
                const filterMethod = $('#filterMethod').val();
                const filterDateRaw = $('#filterDate').val(); // format: YYYY-MM-DD

                // table me date DD/MM/YY format me hai, isliye convert karo comparison ke liye
                let filterDateFormatted = '';
                if (filterDateRaw) {
                    const [yyyy, mm, dd] = filterDateRaw.split('-');
                    filterDateFormatted = `${dd}/${mm}/${yyyy.slice(2)}`;
                }

                let visibleCount = 0;

                $('#paymentTableBody tr').each(function () {
                    const name = $(this).find('td[data-label="Name"]').text().trim().toLowerCase();
                    const upiId = $(this).find('td[data-label="UPI ID"]').text().trim().toLowerCase();
                    const method = $(this).find('td[data-label="Method"]').text().trim();
                    const date = $(this).find('td[data-label="Date"]').text().trim();

                    const matchesSearch = searchMember
                        ? (name.includes(searchMember) || upiId.includes(searchMember))
                        : true;
                    const matchesMethod = filterMethod ? method === filterMethod : true;
                    const matchesDate = filterDateFormatted ? date === filterDateFormatted : true;

                    const isMatch = matchesSearch && matchesMethod && matchesDate;
                    $(this).toggle(isMatch);
                    if (isMatch) visibleCount++;
                });

                if (visibleCount === 0) {
                    toastr.info('No matching records found');
                }
            });


            // View
            $(document).on('click', '.view-screenshot-btn', function () {
                const src = $(this).data('src');
                $('#screenshotModalImg').attr('src', src);
                $('#screenshotModal').addClass('active');
            });
            $('#closeScreenshotModal').on('click', () => $('#screenshotModal').removeClass('active'));
            $('#screenshotModal').on('click', function (e) { if (e.target === this) $(this).removeClass('active'); });
        });
    </script>
