<style>
    .password-modal {
        width: 100%;
        max-width: 430px;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(0, 0, 0, .15);
        animation: popup .25s ease;
    }

    @keyframes popup {
        from {
            transform: scale(.9);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .password-form {
        padding: 25px;
    }

    .password-group {
        margin-bottom: 20px;
    }

    .password-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .password-field {
        position: relative;
    }

    .password-field input {
        width: 100%;
        height: 48px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0 45px 0 15px;
        font-size: 15px;
        transition: .3s;
    }

    .password-field input:focus {
        border-color: #2b7cff;
        outline: none;
        box-shadow: 0 0 0 3px rgba(43, 124, 255, .15);
    }

    .toggle-password {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #888;
    }

    .password-btn {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: #2b7cff;
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: .3s;
    }

    .password-btn:hover {
        background: #165fd3;
    }

    .password-error {
        color: #dc3545;
        font-size: 14px;
        margin-bottom: 15px;
        display: none;
    }
</style>

<header class="header">
    <div class="header-content">
        <div class="header-left">
            <div class="community-name">
                <span>Sarafa Community</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <nav class="nav-menu">
                <a href="/user-app/dashboard" class="nav-item">Home</a>
                <a href="/announcements/Announcement" class="nav-item">Event</a>
                <a href="/Groups/group-member" class="nav-item">Members</a>
                {{!-- <div class="nav-item dropdown">
                    <span>More</span>
                    <i class="fas fa-chevron-down"></i>
                </div> --}}
            </nav>
        </div>
        <div class="header-right">
            <div class="notification-icon">
                <a href="/user-app/notifs">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge" style="display:none;">0</span>
                </a>
            </div>

            <div class="search-container" id="searchContainer">
                <input type="text" placeholder="Search" class="search-input" id="Search-list">
                <i class="fas fa-search search-icon" id="searchToggle"></i>
                <i class="fas fa-xmark search-icon" id="crossToggle" style="display: none; color: #6e6666;"></i>
                <div class="search-dropdown" id="searchDropdown"></div>
            </div>
            <div class="user-avatar" id="userAvatar">
                <img src="{{#if userProfile.profilePicture}}{{userProfile.profilePicture}}{{else}}/assets/images/default-avatar.png{{/if}}"
                    alt="{{userProfile.name}}" class="avatar"
                    onerror="this.onerror=null; this.src='/assets/images/default-avatar.png';">
                <div class="avatar-dropdown" id="avatarDropdown" style="display: none;">
                    <div class="avatar-user-info">
                        <div class="avatar-user-pic"> <img
                                src="{{#if userProfile.profilePicture}}{{userProfile.profilePicture}}{{else}}/assets/images/default-avatar.png{{/if}}"
                                alt="{{userProfile.name}}" class="avatar"></div>
                        <div class="avatar-user-details">
                            <span class="avatar-user-name">{{userProfile.name}} </span>
                            <span class="avatar-user-email">{{user.email}}</span>
                        </div>
                    </div>
                    <ul>
                        <li id="profileDetailsBtn"><i class="fas fa-user-circle"></i> Profile</li>
                        <li><i class="fas fa-cog"></i> Settings</li>
                        <li href="/kyc/KYCverification"><i class="fas fa-id-card"></i> My KYC <span
                                class="kyc-status {{user.kyc_status}}">
                                {{user.kyc_status}}
                            </span></li>
                        <li id="logoutBtn"><i class="fas fa-sign-out-alt"></i>Sign out</li>
                        <li id="changePasswordBtn" class="dropdown-item">
                            <i class="fas fa-key"></i> Change Password
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>

{{!-- Password Model --}}
<div id="changePasswordModal" class="modal-overlay" style="display:none;">
    <div class="password-modal">

        <div class="modal-header">
            <h3><i class="fas fa-lock"></i> Change Password</h3>
            <button class="modal-close-btn" id="closeChangePasswordModal">&times;</button>
        </div>

        <form id="changePasswordForm" class="password-form">

            <div class="password-group">
                <label>New Password</label>
                <div class="password-field">
                    <input type="password" id="changeNewPassword" placeholder="Enter new password" required>
                    <i class="fas fa-eye toggle-password" data-target="changeNewPassword"></i>
                </div>
            </div>

            <div class="password-group">
                <label>Confirm Password</label>
                <div class="password-field">
                    <input type="password" id="changeConfirmPassword" placeholder="Confirm new password" required>
                    <i class="fas fa-eye toggle-password" data-target="changeConfirmPassword"></i>
                </div>
            </div>

            <p id="changePasswordError" class="password-error"></p>

            <button type="submit" class="password-btn">
                <i class="fas fa-key"></i>
                Update Password
            </button>

        </form>

    </div>
</div>

<script>
    document.querySelectorAll(".toggle-password").forEach(icon => {
        icon.addEventListener("click", function () {
            const input = document.getElementById(this.dataset.target);

            if (input.type === "password") {
                input.type = "text";
                this.classList.remove("fa-eye");
                this.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                this.classList.remove("fa-eye-slash");
                this.classList.add("fa-eye");
            }
        });
    });
</script>