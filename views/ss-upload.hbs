<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sarafa Community Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <link rel="icon" href="/assets/favicon/favicon_logo.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/favicon/favicon_logo.png">

    <style>
        .upload-wrapper {
            width: calc(100% - 48px);
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            gap: 24px;
            align-items: flex-start;
            box-sizing: border-box;
            padding-bottom: 50px;
        }

        .upload-card,
        .community-info {
            box-sizing: border-box;
            min-width: 0;
        }

        .upload-card {
            flex: 1 1 0;
            width: 50%;
            max-width: none;

            background: #fff;
            border-radius: 12px;
            box-shadow: 0 6px 24px rgba(47, 149, 255, 0.13);
            padding: 22px;
            border-bottom: 4px solid #551DFF;
        }

        .community-info {
            flex: 1 1 0;
            width: 50%;
            max-width: none;

            background: #fff;
            border-radius: 12px;
            box-shadow: 0 6px 24px rgba(85, 29, 255, 0.13);
            padding: 22px;

            position: relative;
            overflow: hidden;
        }

        /* =========================================================
   COMMON
   ========================================================= */

        .upload-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .upload-input {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid #bdbdbd;
            border-radius: 8px;
            font-size: 1rem;
            box-sizing: border-box;
        }

        .upload-input:focus {
            outline: none;
            border-color: #2f95ff;
            box-shadow: 0 0 0 3px rgba(47, 149, 255, 0.12);
        }

        .upload-hint {
            color: #6b7280;
            font-size: 0.95rem;
            margin-top: 6px;
        }

        .upload-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-top: 12px;
        }

        .upload-btn {
            background: linear-gradient(245deg, #D324A8 -67.04%, #551DFF 129.05%);
            color: #fff;
            border: none;
            border-radius: 22px;
            padding: 10px 18px;
            cursor: pointer;
            font-weight: 600;
        }

        .upload-btn:hover {
            filter: brightness(1.05);
        }

        .preview-wrap {
            display: none;
            margin-top: 14px;
        }

        .preview-label {
            font-weight: 600;
            margin-bottom: 6px;
        }

        .preview-img {
            max-width: 100%;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(25, 118, 210, 0.10);
        }

        /* =========================================================
   COMMUNITY CARD
   ========================================================= */

        .community-info::before {
            content: "";
            position: absolute;
            top: -60px;
            right: -60px;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle,
                    #D324A8 0%,
                    #551DFF 80%,
                    transparent 100%);
            opacity: .12;
            pointer-events: none;
        }

        .community-title {
            font-weight: 800;
            font-size: 1.2rem;
            color: #1976d2;
            margin-bottom: 10px;
        }

        .community-text {
            color: #374151;
            line-height: 1.6;
        }

        .community-list {
            margin-top: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .community-item {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f6faff;
            border: 1px solid #e3f0ff;
            border-radius: 10px;
            padding: 10px;
            font-weight: 600;
            color: #1976d2;
        }

        /* QR */
        #sideQrPreview {
            margin-bottom: 30px !important;
        }

        #sideQrGroupName {
            margin-bottom: 20px !important;
        }

        #sideQrAmount {
            margin-bottom: 20px !important;
        }

        /* =========================================================
   TABLET
   768px - 1024px
   ========================================================= */

        @media (min-width: 768px) and (max-width: 1024px) {

            .main-content {
                width: 100% !important;
                height: auto !important;
                min-height: 100vh !important;
                max-height: none !important;

                overflow-y: auto !important;
                overflow-x: hidden !important;

                padding: 20px 30px 120px !important;
                box-sizing: border-box !important;
            }

            .upload-wrapper {
                width: 100% !important;

                display: flex !important;
                flex-direction: column !important;

                gap: 30px !important;

                margin: 0 auto !important;
                padding: 0 0 120px !important;

                box-sizing: border-box !important;
            }

            .upload-card,
            .community-info {
                width: 100% !important;
                max-width: 100% !important;
                flex: none !important;

                box-sizing: border-box !important;
            }

            /* ===============================
       UPLOAD BOX
       =============================== */

            .upload-card {
                padding: 20px !important;
            }

            /* ===============================
       SELECTED COMMUNITY QR
       =============================== */

            .community-info {
                height: auto !important;
                min-height: auto !important;
                max-height: none !important;

                overflow: visible !important;

                padding: 20px 20px 80px !important;

                /* IMPORTANT */
                margin: 0 0 80px !important;

                box-sizing: border-box !important;
            }

            /* QR ke neeche */
            #sideQrPreview {
                margin-bottom: 35px !important;
            }

            /* Community name */
            #sideQrGroupName {
                margin-bottom: 25px !important;
            }

            /* Amount */
            #sideQrAmount {
                margin-bottom: 30px !important;
            }

            /* Description ke neeche */
            .community-text {
                margin-bottom: 30px !important;
                line-height: 1.6 !important;
            }

            /* Last list ke neeche bhi space */
            .community-list {
                margin-bottom: 50px !important;
            }

            /* QR image */
            #sideQrImg {
                width: 180px !important;
                height: 180px !important;
                object-fit: contain !important;
            }

            .community-list {
                grid-template-columns: 1fr 1fr !important;
                gap: 10px !important;
            }

            .main-container,
            .main-content {
                height: auto !important;
                max-height: none !important;
                overflow: visible !important;
            }

            .community-info {
                margin-bottom: 100px !important;
            }
        }

        /* =========================================================
   MOBILE
   ========================================================= */

        @media (max-width: 767px) {

            html,
            body {
                height: auto !important;
                min-height: 100% !important;
                overflow-x: hidden !important;
                overflow-y: auto !important;
            }

            .main-container {
                width: 100%;
                height: auto !important;
                min-height: 100vh !important;
                overflow: visible !important;
            }

            .main-content {
                width: 100%;
                height: auto !important;
                min-height: 100vh !important;
                max-height: none !important;
                overflow: visible !important;

                padding: 14px 0 70px !important;
                box-sizing: border-box;
            }

            /* Cards ke BAHAR left-right space */
            .upload-wrapper {
                width: calc(100% - 28px);
                max-width: none;

                margin: 0 auto;

                display: flex;
                flex-direction: column;
                gap: 24px;

                padding: 0 0 50px;
                box-sizing: border-box;
            }

            .upload-card,
            .community-info {
                width: 100% !important;
                max-width: 100% !important;
                flex: none !important;
                box-sizing: border-box;
            }

            .upload-card {
                padding: 18px 16px 30px !important;
            }

            .upload-card label {
                display: block;
                margin-bottom: 6px;
            }

            .upload-input {
                width: 100%;
                box-sizing: border-box;
            }

            .upload-actions {
                margin-top: 16px;
                margin-bottom: 20px;
            }

            .community-info {
                height: auto !important;
                min-height: 0 !important;
                max-height: none !important;

                padding: 18px 16px 45px !important;

                /* Mobile me bhi card ke bahar bottom space */
                margin: 0 0 30px !important;

                overflow: visible !important;
            }

            #sideQrPreview {
                width: 100%;
                box-sizing: border-box;
                padding: 16px !important;
                margin-bottom: 30px !important;
                border-radius: 14px !important;
            }

            #sideQrImg {
                width: 155px !important;
                height: 155px !important;
                max-width: 100%;
                object-fit: contain;
            }

            #sideQrGroupName {
                margin-bottom: 16px !important;
                line-height: 1.4;
            }

            #sideQrAmount {
                margin-bottom: 24px !important;
                line-height: 1.4;
            }

            .community-text {
                line-height: 1.55;
                margin-bottom: 18px !important;
            }

            .community-list {
                width: 100%;
                grid-template-columns: 1fr !important;
                gap: 8px;
                margin-top: 14px;
                margin-bottom: 0;
            }

            .community-item {
                width: 100%;
                box-sizing: border-box;
                padding: 10px;
            }
        }

        /* =========================================================
   SMALL MOBILE
   ========================================================= */

        @media (max-width: 480px) {

            .main-content {
                padding: 10px 0 70px !important;
            }

            .upload-wrapper {
                width: calc(100% - 20px);
                gap: 22px;
                padding-bottom: 50px;
            }

            .upload-card {
                padding: 16px 14px 30px !important;
            }

            .community-info {
                padding: 16px 12px 45px !important;
                margin-bottom: 30px !important;
            }

            #sideQrPreview {
                padding: 14px !important;
                margin-bottom: 30px !important;
            }

            #sideQrImg {
                width: 145px !important;
                height: 145px !important;
            }
        }
    </style>
</head>

<body data-user-id="{{user._id}}">
    {{> header}}

    <div class="main-container">
        {{> sidebar}}

        <main class="main-content">
            <div class="upload-wrapper">
                <section class="upload-card">
                    <div class="upload-title"><i class="fas fa-cloud-upload-alt"></i> Upload Payment Screenshot</div>
                    <form id="paymentForm" enctype="multipart/form-data">
                        <input type="hidden" id="reuploadPaymentId" value="{{paymentId}}">
                        <input type="hidden" id="reuploadPeriod" value="{{reuploadPeriod}}">

                        <label for="Communityselection">Select Community</label>
                        <select name="community" id="Communityselection" class="upload-input" required>
                            <option value="">Select</option>
                            {{#each groups}}
                            <option value="{{this._id}}" {{#if (eq this._id ../groupId)}}selected{{/if}}>{{this.g_name}}
                            </option>
                            {{/each}}
                        </select><br><br>

                        <label for="upiId">UPI ID</label>
                        <input type="text" id="upiId" name="upiId" class="upload-input" placeholder="Enter UPI ID"
                            required><br><br>

                        <label for="amount">Amount</label>
                        <input type="number" id="amount" name="amount" class="upload-input" placeholder="Enter amount"
                            required><br><br>

                        <div id="periodMonthGroup">
                            <label for="periodMonth">Payment Month</label>
                            <input type="month" id="periodMonth" name="periodMonth" class="upload-input"><br>
                            <div id="periodMonthError" style="color:#dc2626; font-size:13px; margin:4px 0 10px;"></div>
                        </div>
                        <div id="periodYearGroup" style="display:none;">
                            <label for="periodYear">Payment Year</label>
                            <input type="number" id="periodYear" name="periodYear" class="upload-input"
                                placeholder="e.g. 2026"><br>
                            <div id="periodYearError" style="color:#dc2626; font-size:13px; margin:4px 0 10px;"></div>
                        </div>

                        <label for="method">Payment Method</label>
                        <select id="method" name="method" class="upload-input" required>
                            <option value="">Select Method</option>
                            <option value="UPI">UPI</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cash">Cash</option>
                        </select><br><br>

                        <label for="paymentScreenshot">Select Screenshot</label>
                        <input type="file" id="paymentScreenshot" name="paymentScreenshot" class="upload-input"
                            accept="image/*,application/pdf" required>
                        <div class="upload-hint">Accepted formats: JPG, PNG, PDF. Image files will show a preview.</div>
                        <div class="upload-actions">
                            <button type="submit" class="upload-btn" id="submitPaymentProof"><i
                                    class="fas fa-paper-plane"></i> Submit</button>
                        </div>
                        <div class="preview-wrap" id="paymentPreview">
                            <div class="preview-label">Preview</div>
                            <img id="paymentPreviewImg" class="preview-img" alt="Screenshot Preview" />
                        </div>
                    </form>
                </section>
                <aside class="community-info">
                    <div class="community-title">Selected Community QR</div>

                    <div class="qr-preview" id="sideQrPreview"
                        style="display:none; justify-content:center; align-items:center; background:linear-gradient(135deg,#7b2ff7,#f107a3); padding:20px; border-radius:16px; margin-bottom:30px;">
                        <img id="sideQrImg" src="" alt="QR Code"
                            style="width:200px; height:200px; object-fit:contain; background:#fff; border-radius:12px; padding:10px;">
                    </div>

                    <div style="text-align:center; font-weight:700; color:#1c1e21; margin-bottom:20px;"
                        id="sideQrGroupName"></div>
                    <div style="text-align:center; font-weight:600; color:#551DFF; margin-bottom:20px; font-size:15px;"
                        id="sideQrAmount"></div>
                    <p class="community-text">We are a vibrant network of members collaborating to uplift each other,
                        share opportunities, and celebrate together...</p>
                    <div class="community-list">
                        ...
                    </div>
                </aside>
            </div>
        </main>
    </div>

