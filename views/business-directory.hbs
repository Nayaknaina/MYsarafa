<style>
    /* ==========================================
   Base & Layout Configurations
   ========================================== */
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #f8fafc;
        color: #1e293b;
        line-height: 1.5;
    }

    .main-container {
        display: flex;
        height: calc(100vh - 64px);
        width: 100%;
        overflow: hidden;
    }

    .main-layout {
        display: flex;
        flex-direction: row;
        gap: 2rem;
        align-items: flex-start;
    }

    .main-layout>.flex-1 {
        min-width: 0;
        flex: 1;
    }

    /* ==========================================
   Discover Businesses Grid & Cards
   ========================================== */
    .business-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
        width: 100%;
    }

    @media (max-width: 1200px) {
        .business-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .business-grid {
            grid-template-columns: 1fr;
            padding: 0 10px;
            padding-bottom: 75px;
        }
    }

    /* Card Outer Wrapper */
    .business-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        cursor: pointer;
    }

    .business-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        border-color: #cbd5e1;
    }

    .business-card-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* Business Card Image */
    .business-card-image-wrapper {
        width: 100%;
        height: 180px;
        background-color: #f1f5f9;
        position: relative;
        overflow: hidden;
    }

    .business-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .business-card:hover .business-card-image {
        transform: scale(1.05);
    }

    /* Business Card Details */
    .business-card-content {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .business-name {
        font-size: 1.125rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 0.5rem 0;
        line-height: 1.375;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .business-desc {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0 0 1rem 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .business-category {
        display: inline-block;
        align-self: flex-start;
        background-color: #eff6ff;
        color: #2563eb;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
        margin-bottom: 0.5rem;
    }

    .business-owner {
        font-size: 0.8125rem;
        color: #94a3b8;
        margin: 0 0 1.25rem 0;
    }

    .business-card-btn {
        margin-top: auto;
        width: 100%;
        padding: 0.625rem 1rem;
        background-color: #f8fafc;
        color: #334155;
        border: 1px solid #cbd5e1;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
    }

    .business-card-btn:hover {
        background-color: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
    }

    /* ==========================================
   My Businesses Sidebar
   ========================================== */
    .my-businesses-sidebar {
        width: 100%;
        background-color: #ffffff;
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        height: fit-content;
    }

    @media (min-width: 1024px) {
        .my-businesses-sidebar {
            width: 320px;
            flex-shrink: 0;
        }
    }

    .my-business-list-scroll {
        max-height: 600px;
        overflow-y: auto;
        padding-right: 0.25rem;
    }

    /* Scrollbar Customization */
    .my-business-list-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .my-business-list-scroll::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    .my-business-list-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .my-business-list-scroll::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .my-business-item {
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .my-business-item:hover {
        border-color: #93c5fd;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    /* Action Dropdown Menu */
    .action-menu {
        z-index: 20;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    /* ==========================================
   Modals & Overlays
   ========================================== */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 50;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-content {
        background-color: #ffffff;
        border-radius: 0.75rem;
        max-width: 600px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        animation: slideUp 0.25s ease-out;
    }

    .close-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        line-height: 1;
        color: #64748b;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .close-btn:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }

    /* Modal Animations */
    @keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ==========================================
   Form UI Controls inside Modals
   ========================================== */
    #businessForm {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
    }

    .form-input,
    .form-select,
    .form-textarea {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: #1e293b;
        background-color: #ffffff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-input:focus,
    .form-select:focus,
    .form-textarea:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .form-textarea {
        resize: vertical;
        min-height: 80px;
    }

    .submit-btn {
        background-color: #2563eb;
        color: #ffffff;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background-color 0.2s ease;
        margin-top: 0.5rem;
    }

    .submit-btn:hover {
        background-color: #1d4ed8;
    }

    /* ========================================== Ratings & Reviews Elements ========================================== */
    .star-rating {
        display: inline-flex;
        align-items: center;
        gap: 0.125rem;
    }

    .star {
        font-size: 0.875rem;
        color: #cbd5e1;
    }

    .star.filled {
        color: #f59e0b;
    }

    .star.fa-star-half-alt {
        color: #f59e0b;
    }

    .page-content {
        flex: 1;
        min-width: 0;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Mobile + Tablet */
    @media (max-width: 1023px) {
        .main-layout {
            flex-direction: column;
            width: 100%;
        }

        /* My Businesses ko upar */
        .my-businesses-sidebar {
            order: -1;
            width: 100%;
        }

        /* Discover Businesses niche */
        .main-layout>.flex-1 {
            order: 1;
            width: 100%;
        }
    }
</style>

<body data-user-id="{{user._id}}">

    {{> header}}

    <div class="main-container">
        <!-- Sidebar -->
        {{> sidebar}}
        <div class="w-full p-4 page-content">
            <!-- Header Section -->
            <div class="mb-2">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Business Connect</h1>
                <div class="flex flex-col sm:flex-row gap-4">
                    <input type="text" id="discoverSearch" placeholder="Search discover businesses..."
                        class="flex-1 p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <button id="openAddBusinessModal"
                        class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-medium">
                        Add New Business
                    </button>
                </div>
            </div>

            <!-- Main Layout: Discover Grid + My Businesses Sidebar -->
            <div class="flex gap-8 main-layout">
                <!-- Discover Businesses Grid (70%) -->
                <div class="flex-1">
                    <h2 class="text-xl font-semibold text-gray-800 mb-6">Discover Businesses</h2>
                    {{#if discoverBusinesses.length}}
                    <div class="business-grid" id="discoverBusinessesGrid">
                        {{#each discoverBusinesses}}

                        <div class="business-card" onclick="openBusinessDetailsModal('{{_id}}')">

                            <div class="business-card-inner">

                                <!-- Business Image -->
                                <div class="business-card-image-wrapper">

                                    <img src="{{profile_pic}}" alt="{{name}}" class="business-card-image"
                                        onerror="this.src='/default-business.jpg'">

                                </div>


                                <!-- Card Content -->
                                <div class="business-card-content">

                                    <!-- Business Name -->
                                    <h3 class="business-name">
                                        {{name}}
                                    </h3>


                                    <!-- Description -->
                                    <p class="business-desc">
                                        {{description}}
                                    </p>


                                    <!-- Category -->
                                    <p class="business-category">
                                        {{category}}
                                    </p>


                                    <!-- Owner -->
                                    <p class="business-owner">
                                        {{owner.f_name}} {{owner.l_name}}
                                    </p>


                                    <!-- Button -->
                                    <button type="button" class="business-card-btn"
                                        onclick="event.stopPropagation(); openBusinessDetailsModal('{{_id}}')">

                                        Visit Profile

                                    </button>

                                </div>

                            </div>

                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="text-center py-12 text-gray-500">
                        <p class="text-lg">No businesses available to discover yet.</p>
                    </div>
                    {{/if}}
                </div>

                <!-- My Businesses list (30%) -->
                <aside class="my-businesses-sidebar">
                    <h2 class="text-2xl font-semibold text-gray-800 mb-6">My Businesses</h2>
                    {{#if myBusinesses.length}}
                    <ul class="space-y-4 my-business-list-scroll">
                        {{#each myBusinesses}}
                        <li class="my-business-item flex items-center gap-4 p-4 bg-white rounded-lg shadow border">
                            <img src="{{profile_pic}}" alt="{{name}}"
                                class="w-16 h-16 rounded-lg object-cover flex-shrink-0">
                            <div class="flex-1 min-w-0">
                                <h3 class="font-semibold text-gray-900 truncate">{{name}}</h3>
                                <p class="text-sm text-gray-500">Category: {{category}} | Visibility: {{visibility}}</p>
                            </div>
                            <div class="relative">
                                <button onclick="toggleMenu(this)" class="p-2 rounded hover:bg-gray-100 transition">
                                    <i class="fas fa-ellipsis-v text-gray-600"></i>
                                </button>

                                <div
                                    class="action-menu absolute right-0 mt-2 w-32 bg-white rounded-lg shadow-lg border border-gray-200 transform scale-y-0 origin-top transition-transform duration-200 ease-out">
                                    <button onclick="openBusinessDetailsModal('{{_id}}'); hideAllMenus();"
                                        class="block w-full text-left px-4 py-2 text-sm text-blue-600 hover:bg-blue-50">
                                        <i class="fas fa-eye mr-2"></i> View
                                    </button>
                                    <button onclick="openEditBusinessModal('{{_id}}'); hideAllMenus();"
                                        class="block w-full text-left px-4 py-2 text-sm text-yellow-600 hover:bg-yellow-50">
                                        <i class="fas fa-edit mr-2"></i> Edit
                                    </button>
                                    <button onclick="deleteBusiness('{{_id}}'); hideAllMenus();"
                                        class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                                        <i class="fas fa-trash mr-2"></i> Delete
                                    </button>
                                </div>
                            </div>


                        </li>
                        {{/each}}
                    </ul>
                    {{else}}
                    <div class="text-center py-8 text-gray-500">
                        <p>You haven't listed any businesses yet.</p>
                        <button id="openAddBusinessModalLink" class="mt-2 text-blue-600 hover:underline">Add one
                            now!</button>
                    </div>
                    {{/if}}
                </aside>
            </div>
        </div>

        <!-- Business Details Modal -->
        <div id="businessDetailsModal" class="modal-overlay">
            <div class="modal-content p-6">
                <button class="close-btn" onclick="closeBusinessDetailsModal()">&times;</button>
                <div id="businessDetailsContent">
                    <!-- Dynamically loaded content -->
                </div>
            </div>
        </div>

        <!-- Edit/Add Business Modal -->
        <div id="businessFormModal" class="modal-overlay">
            <div class="modal-content p-6">
                <button class="close-btn" id="closeBusinessFormModal">&times;</button>

                <h3 id="modalTitle">
                    Add New Business
                </h3>
                <form id="businessForm" enctype="multipart/form-data">
                    <input type="hidden" id="businessId" name="id">
                    <input type="text" name="name" class="form-input" placeholder="Business Name" required>
                    <select name="type" class="form-select" required>
                        <option value="">Select Type</option>
                        <option value="retail">Retail</option>
                        <option value="wholesale">Wholesale</option>
                        <option value="manufacturing">Manufacturing</option>
                    </select>
                    <select name="category" class="form-select" required>
                        <option value="">Select Category</option>
                        <option value="Jewelry Retail">Jewelry Retail</option>
                        <option value="Wholesale Supplier">Wholesale Supplier</option>
                        <option value="Manufacturing">Manufacturing</option>
                        <option value="Repair Services">Repair Services</option>
                    </select>
                    <textarea name="description" class="form-textarea" placeholder="Description" required
                        rows="3"></textarea>
                    <input type="text" name="location" class="form-input" placeholder="Location">
                    <input type="text" name="contact" class="form-input" placeholder="Contact (Phone/Email)">
                    <input type="url" name="website" class="form-input" placeholder="Website (Optional)">
                    <select name="visibility" class="form-select" required>
                        <option value="public">Public</option>
                        <option value="private">Private</option>
                    </select>
                    <input type="file" name="profile_pic" class="form-input" accept="image/*">
                    <button type="submit" class="submit-btn">Save Business</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        // Notification helper
        function showNotification(message, type = 'info') {
            toastr.options = { timeOut: 3000, positionClass: 'toast-top-right' };
            if (type === 'success') toastr.success(message);
            else if (type === 'error') toastr.error(message);
            else toastr.info(message);
        }

        // Debounce for search
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        // Utility to generate stars (client-side for modal too, but template uses server-side)
        function renderStars(rating, total = 5) {
            let html = '';
            for (let i = 1; i <= total; i++) {
                if (i <= Math.floor(rating)) {
                    html += '<i class="star filled fas fa-star"></i>';
                } else if (i === Math.ceil(rating) && rating % 1 !== 0) {
                    html += '<i class="star fas fa-star-half-alt"></i>'; // Half star if needed
                } else {
                    html += '<i class="star far fa-star"></i>';
                }
            }
            return html;
        }

        // Open Business Details Modal (fetch via AJAX)
        function openBusinessDetailsModal(businessId) {
            $.ajax({
                url: `/businesses/${businessId}`,
                method: 'GET',
                dataType: 'json',
                success: function (data) {

                    if (!data.success) {
                        showNotification(data.message || 'Failed to load details', 'error');
                        return;
                    }

                    const modal = document.getElementById('businessDetailsModal');
                    const content = document.getElementById('businessDetailsContent');

                    // Current logged-in user
                    const currentUserId = String('{{userId}}').trim();

                    const businessOwnerId = String(
                        data.business.owner?._id || data.business.owner || ''
                    ).trim();

                    const isOwner = businessOwnerId === currentUserId;

                    console.log("========== REVIEW CHECK ==========");
                    console.log("Current User ID:", currentUserId);
                    console.log("Business Owner ID:", businessOwnerId);
                    console.log("Is Owner:", isOwner);

                    const reviewsHtml = data.business.reviews && data.business.reviews.length > 0
                        ? data.business.reviews.map(review => {
                            const reviewerName = review.user
                                ? `${review.user.f_name || ''} ${review.user.l_name || ''}`.trim() || 'Anonymous'
                                : 'Anonymous';
                            const reviewDate = review.createdAt
                                ? new Date(review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
                                : '';
                            return `
        <div class="border-b pb-2 mb-2 p-2 bg-gray-50 rounded">
            <div class="flex justify-between items-center mb-1">
                <span class="font-medium text-sm text-gray-800">${reviewerName}</span>
                <span class="text-xs text-gray-400">${reviewDate}</span>
            </div>
            <div class="star-rating mb-1">${renderStars(review.rating)}</div>
            <p class="text-sm text-gray-600">${review.comment || ''}</p>
        </div>`;
                        }).join('')
                        : '<p class="text-gray-500 italic">No reviews yet.</p>';

                    const hasReviewed = data.business.reviews?.some(review => {
                        const reviewUserId = String(
                            review.user?._id || review.user || ''
                        ).trim();

                        return reviewUserId === currentUserId;
                    });

                    console.log("Has Reviewed:", hasReviewed);

                    const reviewForm = !isOwner && !hasReviewed ? `
        <div class="mt-4 p-4 border-t bg-blue-50 rounded-lg">
            <h5 class="font-semibold mb-2">
                Add Your Review
            </h5>

        <form id="reviewForm">

            <div class="mb-2">
                <label class="block text-sm font-medium mb-1">
                    Rating (1-5):
                </label>

                <select
                    name="rating"
                    class="w-full p-2 border rounded"
                    id="rating"
                    required>

                    <option value="">Select Rating</option>
                    <option value="1">1 ★</option>
                    <option value="2">2 ★★</option>
                    <option value="3">3 ★★★</option>
                    <option value="4">4 ★★★★</option>
                    <option value="5">5 ★★★★★</option>

                </select>
            </div>

            <div class="mb-3">
                <label class="block text-sm font-medium mb-1">
                    Comment:
                </label>

                <textarea
                    name="comment"
                    rows="3"
                    maxlength="500"
                    class="w-full p-2 border rounded"
                    placeholder="Share your experience..."
                    required></textarea>
            </div>

            <button
                type="submit"
                class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600 transition">
                Submit Review
            </button>

        </form>
   </div>
    ` : (!isOwner && hasReviewed ? `
        <div class="mt-4 p-4 border-t bg-gray-50 rounded-lg text-center">
            <p class="text-sm text-gray-600">
                You have already added review for this business.
            </p>
        </div>
    ` : '');

                    const ownerPhone = data.business.owner?.mobile_no;

                    const contactBtn = !isOwner ? `
    <div class="flex gap-2 mt-3">

        <button
            onclick="openWhatsApp('${ownerPhone || ''}')"
            class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">
            <i class="fab fa-whatsapp mr-1"></i>
            WhatsApp
        </button>

        <button
            onclick="callOwner('${ownerPhone || ''}')"
            class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
            <i class="fas fa-phone mr-1"></i>
            Call
        </button>

    </div>
` : '';

                    content.innerHTML = `
                    <h3 class="text-2xl font-bold mb-4">${data.business.name}</h3>
                    <img src="${data.business.profile_pic || '/default-business.jpg'}" alt="${data.business.name}" class="w-full h-64 object-cover rounded mb-4">
                    <p class="text-gray-700 mb-4">${data.business.description}</p>
                    <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
                        <p><strong>Type:</strong> ${data.business.type || 'N/A'}</p>
                        <p><strong>Category:</strong> ${data.business.category}</p>
                        <p><strong>Location:</strong> ${data.business.location || 'N/A'}</p>
                        <p><strong>Contact:</strong> ${data.business.contact || 'N/A'}</p>
                        <p><strong>Website:</strong> <a href="${data.business.website}" target="_blank" class="text-blue-500 hover:underline">${data.business.website || 'N/A'}</a></p>
                        <p><strong>Visibility:</strong> ${data.business.visibility}</p>
                        <p><strong>Avg Rating:</strong> <div class="star-rating inline-flex">${renderStars(data.business.averageRating)}</div> (${data.business.reviews ? data.business.reviews.length : 0} reviews)</p>
                    </div>
                    <div class="mb-4">
                        <h4 class="font-semibold mb-2">Reviews:</h4>
                        ${reviewsHtml}
                    </div>
                    ${reviewForm}
                    ${contactBtn}
                `;
                    modal.style.display = 'flex';

                    // Handle review submission
                    const reviewFormEl = document.getElementById('reviewForm');
                    if (reviewFormEl) {
                        reviewFormEl.onsubmit = function (e) {
                            e.preventDefault();
                            const formData = new FormData(reviewFormEl);
                            const rating = formData.get('rating');
                            if (!rating || isNaN(rating)) {
                                showNotification('Please select a valid rating before submitting', 'error');
                                return;
                            }
                            console.log('Submitting review with rating:', rating);
                            $.ajax({
                                url: `/businesses/${businessId}/review`,
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({
                                    rating: rating,
                                    comment: formData.get('comment')
                                }),
                                success: function (response) {
                                    if (response.success) {
                                        showNotification(response.message, 'success');
                                        openBusinessDetailsModal(businessId);
                                    } else {
                                        showNotification(response.message || 'Failed to add review', 'error');
                                    }
                                },
                                error: function () {
                                    showNotification('Error submitting review', 'error');
                                }
                            });
                        };
                    }
                },
                error: function () {
                    showNotification('Failed to load business details', 'error');
                }
            });
        }

        function closeBusinessDetailsModal() {
            document.getElementById('businessDetailsModal').style.display = 'none';
        }

        // Open Edit Modal (fetch form data via AJAX - assumes controller returns JSON for edit)
        function openEditBusinessModal(businessId) {
            $.ajax({
                url: `/businesses/${businessId}/edit`,
                method: 'GET',
                dataType: 'json', // Assume updated controller returns JSON
                success: function (data) {
                    const form = document.getElementById('businessForm');
                    const modalTitle = document.getElementById('modalTitle');
                    const businessIdInput = document.getElementById('businessId');

                    modalTitle.textContent = 'Edit Business';
                    businessIdInput.value = data.business._id;
                    form.querySelector('[name="name"]').value = data.business.name || '';
                    form.querySelector('[name="type"]').value = data.business.type || '';
                    form.querySelector('[name="category"]').value = data.business.category || '';
                    form.querySelector('[name="description"]').value = data.business.description || '';
                    form.querySelector('[name="location"]').value = data.business.location || '';
                    form.querySelector('[name="contact"]').value = data.business.contact || '';
                    form.querySelector('[name="website"]').value = data.business.website || '';
                    form.querySelector('[name="visibility"]').value = data.business.visibility || '';

                    document.getElementById('businessFormModal').style.display = 'flex';
                    form.onsubmit = function (e) {
                        e.preventDefault();
                        const formData = new FormData(form);
                        formData.append('id', businessId);
                        $.ajax({
                            url: `/businesses/${businessId}`,
                            method: 'PUT',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (res) {
                                showNotification('Business updated successfully', 'success');
                                closeBusinessFormModal();
                                location.reload();
                            },
                            error: function () {
                                showNotification('Failed to update business', 'error');
                            }
                        });
                    };
                },
                error: function () {
                    showNotification('Failed to load edit form', 'error');
                }
            });
        }

        // Reset form for Add New
        function resetBusinessForm() {
            const form = document.getElementById('businessForm');
            form.reset();
            document.getElementById('businessId').value = '';
            document.getElementById('modalTitle').textContent = 'Add New Business';
            form.onsubmit = function (e) {
                e.preventDefault();

                // Get selected image
                const imageInput = form.querySelector('[name="profile_pic"]');
                const imageFile = imageInput.files[0];

                // 1 MB limit
                const maxSize = 1 * 1024 * 1024;

                // Check image size before sending request
                if (imageFile && imageFile.size > maxSize) {

                    showNotification(
                        'Image size must be less than 1 MB',
                        'error'
                    );

                    // Clear selected image
                    imageInput.value = '';

                    return;
                }

                const formData = new FormData(form);

                $.ajax({
                    url: '/businesses/business',
                    method: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,

                    success: function (res) {
                        showNotification(
                            'Business added successfully',
                            'success'
                        );

                        closeBusinessFormModal();
                        location.reload();
                    },

                    error: function (xhr) {

                        console.log('UPLOAD ERROR:', xhr);
                        console.log('STATUS:', xhr.status);
                        console.log('RESPONSE:', xhr.responseText);

                        let message = 'Failed to add business';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }

                        showNotification(message, 'error');
                    }
                });
            };
        }

        function closeBusinessFormModal() {
            document.getElementById('businessFormModal').style.display = 'none';
            resetBusinessForm();
        }

        // Contact Owner (placeholder)
        function openWhatsApp(phone) {
            if (!phone) {
                showNotification('Owner phone number is not available', 'error');
                return;
            }

            let cleanPhone = phone.toString().replace(/\D/g, '');

            // India number
            if (cleanPhone.length === 10) {
                cleanPhone = '91' + cleanPhone;
            }

            window.open(`https://wa.me/${cleanPhone}`, '_blank');
        }

        function callOwner(phone) {
            if (!phone) {
                showNotification('Owner phone number is not available', 'error');
                return;
            }

            window.location.href = `tel:${phone}`;
        }

        // Delete Business
        function deleteBusiness(id) {
            if (confirm('Are you sure you want to delete this business?')) {
                $.ajax({
                    url: `/businesses/${id}/delete`,
                    method: 'DELETE',
                    success: function (data) {
                        if (data.success) {
                            location.reload();
                            showNotification('Business deleted successfully', 'success');
                        } else {
                            showNotification('Failed to delete', 'error');
                        }
                    },
                    error: function (err) {
                        showNotification('Error: ' + err.responseText, 'error');
                    }
                });
            }
        }

        // DOM Ready
        document.addEventListener('DOMContentLoaded', function () {
            // Search for Discover
            const discoverSearch = document.getElementById('discoverSearch');
            const discoverGrid = document.getElementById('discoverBusinessesGrid');
            if (discoverSearch && discoverGrid) {
                discoverSearch.addEventListener('input', debounce(function () {
                    const value = this.value.toLowerCase();
                    discoverGrid.querySelectorAll('.business-card').forEach(card => {
                        const name = card.querySelector('h3').textContent.toLowerCase();
                        card.style.display = name.includes(value) ? 'block' : 'none';
                    });
                }, 300));
            }

            // Modal Controls
            const addModalBtn = document.getElementById('openAddBusinessModal');
            const addModalLink = document.getElementById('openAddBusinessModalLink');
            const closeFormBtn = document.getElementById('closeBusinessFormModal');
            const businessModal = document.getElementById('businessDetailsModal');
            const businessFormModal = document.getElementById('businessFormModal');

            if (addModalBtn) addModalBtn.onclick = () => { resetBusinessForm(); businessFormModal.style.display = 'flex'; };
            if (addModalLink) addModalLink.onclick = () => { resetBusinessForm(); businessFormModal.style.display = 'flex'; };
            if (closeFormBtn) closeFormBtn.onclick = closeBusinessFormModal;

            // Close modals on overlay click
            [businessModal, businessFormModal].forEach(modal => {
                modal.onclick = (e) => { if (e.target === modal) modal.style.display = 'none'; };
            });

            // Escape key to close modals
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeBusinessDetailsModal();
                    closeBusinessFormModal();
                }
            });
        });
        function toggleMenu(btn) {
            const menu = btn.nextElementSibling;
            const isVisible = menu.classList.contains('scale-y-100');

            hideAllMenus();
            if (!isVisible) {
                menu.classList.add('scale-y-100');
                menu.classList.remove('scale-y-0');
            }
        }

        function hideAllMenus() {
            document.querySelectorAll('.action-menu').forEach(menu => {
                menu.classList.remove('scale-y-100');
                menu.classList.add('scale-y-0');
            });
        }

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.relative')) hideAllMenus();
        });

    </script>
    <script type="module" src="/js/firebase.js"></script>
</body>

